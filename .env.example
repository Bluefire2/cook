# Copy to .env.local for local dev; set the same values in the Vercel project
# settings for production. Server-side only — never add a VITE_ prefix to any
# of these, or Vite will inline the value into the client bundle.

# Required. Read implicitly by `new Anthropic()` in api/chat.ts and api/import.ts.
ANTHROPIC_API_KEY=

# Required. Shared secret checked against the x-app-password header on both
# endpoints; must match the password saved in the app's Settings screen.
# Any value you choose — replace this placeholder.
APP_PASSWORD=change-me

# Optional. Defaults to claude-sonnet-4-5 when unset.
# CHAT_MODEL=claude-sonnet-4-5
