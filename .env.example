# Copy to .env.local for local dev. For production, set the same values on the
# Cloud Run service with `gcloud run services update --update-env-vars` — never
# baked into the image. The Vercel deployment still exists and keeps its own
# copy. Server-side only — never add a VITE_ prefix to any
# of these, or Vite will inline the value into the client bundle.

# Required. Passed to new GoogleGenAI({ apiKey }) in api/chat.ts and api/import.ts.
GEMINI_API_KEY=

# Required. Shared secret checked against the x-app-password header on both
# endpoints; must match the password saved in the app's Settings screen.
# Any value you choose — replace this placeholder.
APP_PASSWORD=change-me

# Optional. Defaults to gemini-3.7-flash when unset.
# CHAT_MODEL=gemini-3.7-flash
