{
  "manifest_version": 3,
  "name": "Sous importer",
  "version": "1.0.0",
  "description": "Import the recipe on this page into your Sous library.",
  "permissions": ["cookies", "scripting", "activeTab", "storage"],
  "host_permissions": ["http://localhost/*", "https://sous.kyrylo.lol/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Import to Sous",
    "default_icon": {
      "180": "icons/icon-180.png",
      "192": "icons/icon-192.png"
    }
  },
  "icons": {
    "180": "icons/icon-180.png",
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  }
}
